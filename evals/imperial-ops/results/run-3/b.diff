+/* Which alerts that reached a person the reader has acknowledged, and when. It's the reader's
+ * own state, not the stream's, so it's kept here and laid over the alerts by the page (see
+ * withAcknowledgements in model/stream.ts). A store rather than page state, so it's still
+ * there after a visit to the Rules page. In the real app this is a call to the paging
+ * service, and the stream sends the acknowledgement back. */
+
+import { create } from 'zustand';
+
+interface AcknowledgementsState {
+  /** Alert id → when it was acknowledged. */
+  acks: ReadonlyMap<string, number>;
+  /** Acknowledge an alert at a time, or take it back with null. */
+  mark: (id: string, at: number | null) => void;
+}
+
+export const useAcknowledgements = create<AcknowledgementsState>((set, get) => ({
+  acks: new Map(),
+  mark: (id, at) => {
+    // A new map, never an edit of the old one: that's how React notices the change.
+    const acks = new Map(get().acks);
+    if (at === null) acks.delete(id);
+    else acks.set(id, at);
+    set({ acks });
+  },
+}));
