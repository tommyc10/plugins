diff --git a/src/pages/alerts/hooks/useAcknowledged.ts b/src/pages/alerts/hooks/useAcknowledged.ts
new file mode 100644
index 0000000..f08695e
--- /dev/null
+++ b/src/pages/alerts/hooks/useAcknowledged.ts
@@ -0,0 +1,22 @@
+/* Which paged alerts a person has picked up, and when. A store rather than page state, so
+ * an acknowledgement survives a trip to the Rules page and back. In the real app this is
+ * the incident's acknowledgement, read from and written to the API. */
+
+import { create } from 'zustand';
+
+interface AcknowledgedState {
+  /** When each acknowledged alert was picked up, in milliseconds, by alert id. */
+  at: Record<string, number>;
+  acknowledge: (id: string, at: number) => void;
+  undo: (id: string) => void;
+}
+
+export const useAcknowledged = create<AcknowledgedState>((set, get) => ({
+  at: {},
+  acknowledge: (id, at) => set({ at: { ...get().at, [id]: at } }),
+  undo: (id) => {
+    const at = { ...get().at };
+    delete at[id];
+    set({ at });
+  },
+}));
