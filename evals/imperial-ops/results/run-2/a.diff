diff --git a/src/pages/alerts/hooks/useAcknowledged.ts b/src/pages/alerts/hooks/useAcknowledged.ts
new file mode 100644
index 0000000..4404b31
--- /dev/null
+++ b/src/pages/alerts/hooks/useAcknowledged.ts
@@ -0,0 +1,21 @@
+/* Which paged alerts a person has picked up, and when. Kept outside the page so a trip to
+ * the Rules page and back doesn't forget them. In the real app this becomes a mutation that
+ * tells the paging service, and the acknowledgement arrives back on the alert itself. */
+
+import { create } from 'zustand';
+
+interface AcknowledgedState {
+  /** Alert id → when it was acknowledged, in stream time. */
+  at: Record<string, number>;
+  acknowledge: (id: string, at: number) => void;
+  undo: (id: string) => void;
+}
+
+export const useAcknowledged = create<AcknowledgedState>((set, get) => ({
+  at: {},
+  acknowledge: (id, at) => set({ at: { ...get().at, [id]: at } }),
+  undo: (id) => {
+    const { [id]: _, ...rest } = get().at;
+    set({ at: rest });
+  },
+}));
