diff --git a/src/pages/alerts/hooks/useAcks.ts b/src/pages/alerts/hooks/useAcks.ts
new file mode 100644
index 0000000..be149af
--- /dev/null
+++ b/src/pages/alerts/hooks/useAcks.ts
@@ -0,0 +1,22 @@
+/* Which pages a person has picked up. Kept outside the page, so a visit to the Rules page
+ * and back doesn't forget them. In the real app this becomes a mutation on the incident,
+ * and the stream brings the acknowledgement back with the alert. */
+
+import { create } from 'zustand';
+
+interface AcksState {
+  /** Alert id → when it was acknowledged, in milliseconds. */
+  acks: Record<string, number>;
+  ack: (id: string, at: number) => void;
+  unack: (id: string) => void;
+}
+
+export const useAcks = create<AcksState>((set, get) => ({
+  acks: {},
+  ack: (id, at) => set({ acks: { ...get().acks, [id]: at } }),
+  unack: (id) => {
+    const acks = { ...get().acks };
+    delete acks[id];
+    set({ acks });
+  },
+}));
